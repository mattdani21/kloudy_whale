# Redis
REDIS_URL=redis://localhost:6379

# LLM providers
DEEPSEEK_API_KEY=sk-...
KIMI_API_KEY=sk-...

# API auth (clients send this as X-API-Key header)
API_KEY=dev-key-change-me

# Limits
MAX_STEPS=25
DEFAULT_TOKEN_BUDGET=50000

# Notifications
NOTIFICATION_WEBHOOK=
SLACK_WEBHOOK_URL=https://hooks.slack.com/...

# Logging
LOG_LEVEL=INFO
